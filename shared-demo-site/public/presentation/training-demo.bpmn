<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_WholeTraining" targetNamespace="https://example.invalid/cosanum/demo-day" exporter="Cosanum synthetic communication model" exporterVersion="2">
  <bpmn:process id="Process_WholeTraining" name="Ein Trainingsfall mit Ausnahmewegen" isExecutable="false">
    <bpmn:documentation>Nicht ausführbares Kommunikationsmodell der synthetischen Site. Zielniveau Mitarbeiter 1–3. Keine verbundenen Google-Kalender, automatischen Mails, Push oder produktiven Matrixschreibvorgänge. Geplante Erinnerung ist nur Annotation und steuert keinen Tokenfluss.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Responsibilities">
      <bpmn:lane id="Lane_daniel" name="Daniel · Process &amp; Quality">
        <bpmn:flowNodeRef>request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>offers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancel_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reschedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>before</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelbefore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>early</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>begin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>during</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelduring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>report</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>failed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>retrain</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_app" name="Anwendung · synthetischer Raum">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>access</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>authorized</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invite</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>invitation_open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>remaining</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelendbefore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>timing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>scheduled</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>training</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>cancelendduring</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>received</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>waiting</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>result</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>skill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>history</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>done</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_trainee" name="Matthew · Teilnehmer">
        <bpmn:flowNodeRef>credentials</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>recoverable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>newroom</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirmation_merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>response</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>accept</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>confirm</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
